{
  "version": 2,
  "appKey": "mind",
  "appVersion": "1.0.0",
  "engineRequires": ">=1.0.0",
  "requiresCore": true,
  "collections": [
    {
      "collection": "groups",
      "file": "groups.json",
      "matchBy": "keyLower",
      "installMode": "shared",
      "exportFields": [
        "key",
        "name",
        "description",
        "permissions",
        "appId",
        "systemManaged"
      ]
    },
    {
      "collection": "apps",
      "file": "apps.json",
      "matchBy": "key",
      "installMode": "shared",
      "filter": {
        "key": "mind"
      }
    },
    {
      "collection": "users",
      "file": "users.json",
      "matchBy": "_id",
      "installMode": "shared",
      "exportFields": [
        "username",
        "usernameLower",
        "isFunctional",
        "isSystem",
        "appId",
        "groupIds"
      ]
    },
    {
      "collection": "items",
      "file": "items.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": [
        "key",
        "collection",
        "title",
        "titleSingular",
        "titlePlural",
        "description",
        "ai",
        "icon",
        "appId",
        "schema",
        "ui",
        "api",
        "auth",
        "tier",
        "kind",
        "behavior",
        "x-rls"
      ],
      "filter": {
        "appId": "<thisAppId>"
      }
    },
    {
      "collection": "dashboards",
      "file": "dashboards.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "appId",
        "name",
        "icon",
        "isHome",
        "interactive",
        "groupIds",
        "statusId",
        "gridsterConfigId",
        "tiles",
        "systemManaged"
      ]
    },
    {
      "collection": "windows",
      "file": "windows.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "dashboardId",
        "title",
        "icon",
        "groupIds",
        "modelId",
        "prefabId",
        "prefabConfig",
        "systemManaged"
      ]
    },
    {
      "collection": "item_tree_views",
      "file": "item_tree_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "modelId",
        "appId",
        "name",
        "groupBy",
        "rowDensity",
        "showAvatar",
        "avatarField",
        "avatarShape",
        "showBadge",
        "badgeField",
        "showTitle",
        "titleField",
        "titleWeight",
        "showSubtitle",
        "subtitleField",
        "subtitleLines",
        "showContent",
        "contentField",
        "contentLines",
        "showIcon",
        "showRightTop",
        "rightTopField",
        "showRightMiddle",
        "rightMiddleField",
        "rightMiddleKind",
        "showRightBottom",
        "rightBottomField",
        "rightBottomKind",
        "sortFields",
        "isDefault",
        "pinned",
        "order",
        "systemManaged"
      ],
      "filter": {
        "appId": "<thisAppId>"
      }
    },
    {
      "collection": "item_chart_views",
      "file": "item_chart_views.json",
      "matchBy": "_id",
      "installMode": "installConfig",
      "exportFields": [
        "modelId",
        "appId",
        "name",
        "data",
        "map",
        "builder",
        "isDefault",
        "pinned",
        "order",
        "systemManaged"
      ],
      "filter": {
        "appId": "<thisAppId>"
      }
    },
    {
      "collection": "scenarios",
      "file": "scenarios.json",
      "matchBy": "key",
      "installMode": "shared",
      "exportFields": [
        "key",
        "title",
        "subtitle",
        "description",
        "appKey",
        "mode",
        "trigger",
        "audience",
        "isPublished",
        "version",
        "tags",
        "steps"
      ],
      "filter": {
        "appId": "<thisAppId>"
      }
    }
  ]
}
